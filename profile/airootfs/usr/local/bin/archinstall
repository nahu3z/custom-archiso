#!/usr/bin/env bash

if [[ -t 0 || -t 1 ]]; then
	read -r -p 'Install the RTL8192EU driver in the installed system? [y/N] ' install_driver </dev/tty
	case "${install_driver,,}" in
		y|yes)
			exec /usr/bin/archinstall "$@" --config /etc/archinstall/rtl8192eu.json
			;;
	esac
fi

exec /usr/bin/archinstall "$@"